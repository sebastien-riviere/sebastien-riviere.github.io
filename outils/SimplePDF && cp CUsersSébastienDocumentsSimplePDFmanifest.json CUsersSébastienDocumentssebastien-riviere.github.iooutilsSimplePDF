<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>SimplePDF — Outil PDF local</title>
  <meta name="description" content="Manipuler, alléger, réorganiser et exporter ses PDF directement dans le navigateur, sans compte, sans serveur, sans upload.">
  <link rel="manifest" href="manifest.json">
  <meta name="theme-color" content="#2d5a8e">
  <meta name="mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="default">
  <meta name="apple-mobile-web-app-title" content="SimplePDF">

  <!-- CSS -->
  <link rel="stylesheet" href="css/main.css">
  <link rel="stylesheet" href="css/layout.css">
  <link rel="stylesheet" href="css/components.css">

  <!-- PDF.js 3.x UMD — expose window.pdfjsLib -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <!-- pdf-lib -->
  <script src="https://unpkg.com/pdf-lib@1.17.1/dist/pdf-lib.min.js"></script>

  <!-- JSZip -->
  <script src="https://cdn.jsdelivr.net/npm/jszip@3.10.1/dist/jszip.min.js"></script>

  <!-- SortableJS -->
  <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.3/Sortable.min.js"></script>

  <script>
    // Configure le worker PDF.js
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc =
        'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  </script>
</head>
<body>
<div id="app">

  <!-- ═══ HEADER ═══ -->
  <header class="app-header">
    <button id="btn-sidebar-left" class="btn btn-ghost btn-icon mobile-only" title="Actions" aria-label="Ouvrir le menu actions">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <line x1="2" y1="4" x2="14" y2="4"/><line x1="2" y1="8" x2="14" y2="8"/><line x1="2" y1="12" x2="14" y2="12"/>
      </svg>
    </button>
    <a href="#" class="app-logo" aria-label="SimplePDF">
      <svg class="app-logo-icon" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="5" y="2" width="14" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <rect x="9" y="6" width="18" height="20" rx="2" fill="currentColor" opacity="0.15"/>
        <rect x="9" y="6" width="18" height="20" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/>
        <line x1="13" y1="11" x2="23" y2="11" stroke="currentColor" stroke-width="1.2"/>
        <line x1="13" y1="15" x2="23" y2="15" stroke="currentColor" stroke-width="1.2"/>
        <line x1="13" y1="19" x2="19" y2="19" stroke="currentColor" stroke-width="1.2"/>
      </svg>
      <span class="app-logo-name">Simple<span>PDF</span></span>
    </a>

    <nav class="app-header-workflow" aria-label="Workflow">
      <span class="workflow-step" id="wf-import">Importer</span>
      <span class="workflow-sep">›</span>
      <span class="workflow-step" id="wf-organize">Organiser</span>
      <span class="workflow-sep">›</span>
      <span class="workflow-step" id="wf-modify">Modifier</span>
      <span class="workflow-sep">›</span>
      <span class="workflow-step" id="wf-compress">Alléger</span>
      <span class="workflow-sep">›</span>
      <span class="workflow-step" id="wf-export">Exporter</span>
    </nav>

    <button id="btn-sidebar-right" class="btn btn-ghost btn-icon mobile-only" title="Stats & Export" aria-label="Ouvrir les stats et exports">
      <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
        <rect x="2" y="2" width="5" height="5" rx="1"/><rect x="9" y="2" width="5" height="5" rx="1"/>
        <rect x="2" y="9" width="5" height="5" rx="1"/><rect x="9" y="9" width="5" height="5" rx="1"/>
      </svg>
    </button>
    <div class="app-status">
      <div id="status-bar" class="status-bar status-ready">
        <div class="status-dot"></div>
        <span class="status-text">Prêt</span>
      </div>
    </div>
  </header>

  <!-- ═══ BANDEAU CONFIDENTIALITÉ ═══ -->
  <div class="privacy-banner" role="note">
    <svg class="privacy-banner-icon" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
      <path d="M8 2L3 5v4c0 3 2.5 5 5 6 2.5-1 5-3 5-6V5z"/>
      <line x1="8" y1="7" x2="8" y2="10"/>
      <circle cx="8" cy="6" r="0.5" fill="currentColor"/>
    </svg>
    <span class="privacy-banner-text">
      Tous les fichiers sont traités localement dans votre navigateur. Aucun document n'est envoyé vers un serveur.
    </span>
  </div>

  <!-- ═══ CORPS ═══ -->
  <div class="app-body">

    <!-- ── SIDEBAR GAUCHE ── -->
    <aside class="sidebar-left" aria-label="Actions">

      <!-- Import -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Importer</div>
        <input type="file" id="file-input" accept=".pdf,.jpg,.jpeg,.png,.webp" multiple class="visually-hidden">
        <button id="btn-import" class="btn btn-primary btn-full">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 2v8M4 6l4-4 4 4"/>
            <path d="M2 12v2h12v-2"/>
          </svg>
          Importer des fichiers
        </button>
        <p class="text-xs text-muted" style="margin-top:6px">PDF, JPG, PNG, WebP</p>
      </section>

      <!-- Sélection -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Sélection</div>
        <div class="btn-group-full">
          <button id="btn-select-all" class="btn btn-secondary btn-full" disabled>
            Tout sélectionner
          </button>
          <button id="btn-clear-selection" class="btn btn-ghost btn-full" disabled>
            Effacer la sélection
          </button>
        </div>
        <p class="text-xs text-muted" style="margin-top:6px">Clic = sélectionner · Shift = plage</p>
      </section>

      <!-- Actions PDF -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Actions</div>
        <div class="btn-group-full">
          <button id="btn-delete-selection" class="btn btn-danger btn-full" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <polyline points="2,4 14,4"/><path d="M5 4V2h6v2"/><path d="M3 4l1 10h8l1-10"/>
            </svg>
            Supprimer la sélection
          </button>
          <button id="btn-extract-selection" class="btn btn-secondary btn-full" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <rect x="2" y="2" width="8" height="10" rx="1"/><rect x="6" y="5" width="8" height="10" rx="1"/>
            </svg>
            Extraire la sélection
          </button>
        </div>
      </section>

      <!-- Rotation -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Rotation sélection</div>
        <div class="btn-group">
          <button id="btn-rotate-left-sel" class="btn btn-secondary" style="flex:1" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M4 8a4 4 0 1 0 4-4H5"/><polyline points="5,2 5,6 9,6"/>
            </svg>
            Gauche
          </button>
          <button id="btn-rotate-right-sel" class="btn btn-secondary" style="flex:1" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M12 8a4 4 0 1 1-4-4h3"/><polyline points="11,2 11,6 7,6"/>
            </svg>
            Droite
          </button>
        </div>
      </section>

      <!-- Éditer -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Éditer</div>
        <div class="btn-group-full">
          <button id="btn-add-text" class="btn btn-secondary btn-full" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" style="width:13px;height:13px">
              <line x1="3" y1="4" x2="13" y2="4"/><line x1="8" y1="4" x2="8" y2="13"/>
            </svg>
            Ajouter du texte
          </button>
          <button id="btn-signature" class="btn btn-secondary btn-full" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" style="width:13px;height:13px">
              <path d="M3 12c2-4 3-7 4-7s1 3 2 3 2-2 3-2"/>
              <line x1="2" y1="14" x2="14" y2="14"/>
            </svg>
            Signer
          </button>
        </div>
      </section>

      <!-- Outils PDF -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Outils</div>
        <div class="btn-group-full">
          <button id="btn-grayscale" class="btn btn-secondary btn-full" disabled>Niveaux de gris</button>
          <button id="btn-split" class="btn btn-secondary btn-full" disabled>Séparer les pages</button>
          <button id="btn-page-numbers" class="btn btn-secondary btn-full" disabled>Numéroter les pages</button>
          <button id="btn-watermark" class="btn btn-secondary btn-full" disabled>Filigrane…</button>
          <div class="btn-group" style="gap:4px">
            <select id="stamp-select" class="input-field" style="flex:1;font-size:11px;padding:4px 6px">
              <option value="BROUILLON">BROUILLON</option>
              <option value="CONFIDENTIEL">CONFIDENTIEL</option>
              <option value="VALIDÉ">VALIDÉ</option>
              <option value="À SIGNER">À SIGNER</option>
              <option value="URGENT">URGENT</option>
            </select>
            <button id="btn-stamp" class="btn btn-secondary" style="flex-shrink:0;white-space:nowrap" disabled>Tampon</button>
          </div>
          <button id="btn-header-footer" class="btn btn-secondary btn-full" disabled>En-tête / Pied…</button>
          <button id="btn-metadata" class="btn btn-secondary btn-full" disabled>Métadonnées…</button>
        </div>
      </section>

      <!-- Presets -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Presets rapides</div>
        <div id="presets-container" class="btn-group-full"></div>
      </section>

      <!-- Espace -->
      <section class="sidebar-section" style="margin-top:auto">
        <button id="btn-clear-workspace" class="btn btn-ghost btn-full" disabled>
          Vider l'espace
        </button>
      </section>

    </aside>

    <!-- ── ZONE CENTRALE ── -->
    <main class="workspace" id="workspace" aria-label="Espace de travail">

      <!-- Dropzone (vide) -->
      <div id="dropzone" class="dropzone" aria-label="Zone de dépôt">
        <div class="dropzone-inner" style="display:flex;flex-direction:column;align-items:center;gap:16px">
          <svg class="dropzone-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect x="8" y="6" width="24" height="30" rx="3"/>
            <rect x="16" y="12" width="24" height="30" rx="3" fill="currentColor" opacity="0.1"/>
            <rect x="16" y="12" width="24" height="30" rx="3"/>
            <line x1="22" y1="22" x2="34" y2="22"/>
            <line x1="22" y1="27" x2="34" y2="27"/>
          </svg>
          <div>
            <div class="dropzone-title">Dépose tes PDF et images ici</div>
            <div class="dropzone-sub" style="margin-top:6px">ou clique pour sélectionner des fichiers</div>
          </div>
          <div class="dropzone-formats">PDF · JPG · PNG · WebP</div>
          <button class="btn btn-primary" onclick="document.getElementById('file-input').click()">
            Importer des fichiers
          </button>
          <p class="text-xs text-muted">Tout reste dans ton navigateur. Aucun upload serveur.</p>
        </div>
      </div>

      <!-- Grille pages -->
      <div id="pages-grid" class="pages-grid" style="display:none" aria-label="Pages importées"></div>

      <!-- Barre de progression -->
      <div id="progress-wrap" style="display:none;margin-top:12px">
        <div class="progress-bar-wrap">
          <div id="progress-bar" class="progress-bar"></div>
        </div>
      </div>

    </main>

    <!-- ── SIDEBAR DROITE ── -->
    <aside class="sidebar-right" aria-label="Statistiques et export">

      <!-- Stats -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Statistiques</div>
        <div class="stats-grid">
          <div class="stat-item">
            <span class="stat-label">Fichiers</span>
            <span class="stat-value" id="stat-files">0</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Pages</span>
            <span class="stat-value" id="stat-pages">0</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Sélectionnées</span>
            <span class="stat-value" id="stat-selected">0</span>
          </div>
          <div class="stat-item">
            <span class="stat-label">Poids initial</span>
            <span class="stat-value" id="stat-size-in">—</span>
          </div>
          <div class="stat-item" style="grid-column: span 2">
            <span class="stat-label">Dernier export</span>
            <span class="stat-value" id="stat-size-out">—</span>
            <span class="stat-delta" id="stat-delta"></span>
          </div>
        </div>
      </section>

      <!-- Export PDF -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Exporter</div>
        <div class="btn-group-full">
          <button id="btn-export-pdf" class="btn btn-primary btn-full" disabled>
            <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M8 2v8M4 10l4 4 4-4"/><path d="M2 14h12"/>
            </svg>
            Exporter en PDF
          </button>
          <button id="btn-export-png" class="btn btn-secondary btn-full" disabled>
            PNG ZIP (toutes les pages)
          </button>
        </div>
      </section>

      <!-- Export JPG -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Export JPG</div>
        <div class="slider-wrap" style="margin-bottom:8px">
          <div class="slider-label">
            <span class="slider-label-text">Qualité JPG</span>
            <span class="slider-value" id="jpg-quality-value">85%</span>
          </div>
          <input type="range" id="jpg-quality-slider" min="30" max="100" value="85">
        </div>
        <button id="btn-export-jpg" class="btn btn-secondary btn-full" disabled>
          JPG ZIP (toutes les pages)
        </button>
      </section>

      <!-- Compression -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Compression visuelle</div>
        <div class="message message-warning" style="margin-bottom:8px;font-size:11px">
          <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M8 2L2 14h12L8 2z"/><line x1="8" y1="7" x2="8" y2="10"/><circle cx="8" cy="12" r="0.5" fill="currentColor"/>
          </svg>
          Le texte peut perdre en netteté. Idéal pour les scans.
        </div>
        <div class="slider-wrap" style="margin-bottom:8px">
          <div class="slider-label">
            <span class="slider-label-text">Qualité</span>
            <span class="slider-value" id="compression-value">70%</span>
          </div>
          <input type="range" id="compression-slider" min="10" max="95" value="70">
        </div>
        <button id="btn-export-compressed" class="btn btn-secondary btn-full" disabled>
          Exporter compressé
        </button>
      </section>

      <!-- Extraction texte -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Texte brut</div>
        <p class="text-xs text-muted" style="margin-bottom:8px">PDF textuel uniquement — les scans nécessitent un OCR non inclus.</p>
        <button id="btn-export-text" class="btn btn-secondary btn-full" disabled>
          Extraire le texte
        </button>
      </section>

      <!-- Dernier export -->
      <section class="sidebar-section">
        <div class="sidebar-section-title">Dernier export</div>
        <div id="last-export">
          <span class="text-muted text-xs">Aucun export pour cette session.</span>
        </div>
      </section>

    </aside>

  </div><!-- /.app-body -->

</div><!-- /#app -->

<!-- Overlay mobile sidebars -->
<div id="sidebar-overlay" class="sidebar-overlay"></div>

<!-- Toast container -->
<div id="toast-container" aria-live="polite"></div>

<!-- JS modules -->
<script type="module" src="js/app.js"></script>

</body>
</html>
